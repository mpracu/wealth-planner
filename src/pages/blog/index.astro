---
import Layout from '../../layouts/Layout.astro';
import StaticHeader from '../../components/StaticHeader.astro';
import DisclaimerBanner from '../../components/DisclaimerBanner.astro';
import '../../App.css';
import '../../components/Blog.css';
import { extractTags, cleanExcerpt } from '../../lib/renderPost.js';

const apiBase = import.meta.env.VITE_API_ENDPOINT;
const res = await fetch(`${apiBase}/blog-posts`);
const rawPosts = await res.json();

const posts = rawPosts
  .filter((post) => post.slug)
  .map((post) => ({
    ...post,
    tags: extractTags(post.content),
    excerpt: cleanExcerpt(post.content, 180),
    date: new Date(post.publishedDate).toISOString().split('T')[0],
  }));
---

<Layout
  title="Artículos de finanzas e inversión - Caudal"
  description="Consejos y estrategias sobre patrimonio e inversión. Contenido informativo y educativo, no asesoramiento financiero."
  canonical="https://caudalfinanzas.com/blog/"
>
  <StaticHeader active="blog" />
  <div class="blog">
    <div class="blog-header">
      <h1>Artículos de finanzas e inversión</h1>
      <p>Consejos y estrategias sobre patrimonio e inversión.</p>
    </div>

    <DisclaimerBanner />

    {posts.length === 0 ? (
      <p class="blog-empty">Todavía no hay artículos publicados. Vuelve pronto.</p>
    ) : (
      <div class="blog-grid">
        {posts.map((post) => (
          <a class="blog-card" href={`/articulo/${post.slug}/`}>
            <img src={post.image} alt={post.title} />
            <div class="blog-card-content">
              <div class="blog-card-tags">
                {post.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <h2>{post.title}</h2>
              <p class="excerpt">{post.excerpt}</p>
              <div class="blog-card-meta">
                <span>{post.date}</span>
                <span>•</span>
                <span>8 min de lectura</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .blog-empty {
    color: var(--text-secondary);
    text-align: center;
    padding: 2rem 0;
  }
</style>
